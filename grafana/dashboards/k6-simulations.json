              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 90000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Queue time (until the worker starts the simulation)",
      "description": "API answers 404 until the background worker picks the job up. Threshold p95 < 15 s.",
      "datasource": {
        "type": "influxdb",
        "uid": "k6-influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
