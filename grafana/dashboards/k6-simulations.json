      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "k6-influxdb"
          },
          "rawQuery": true,
          "query": "SELECT mean(\"value\") FROM \"simulation_time_per_iteration\" WHERE $timeFilter GROUP BY time($__interval), \"model\" fill(none)",
          "resultFormat": "time_series",
          "alias": "$tag_model"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
