    },
    {
      "type": "timeseries",
      "title": "Load: virtual users and requests per second",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "k6-influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "k6-influxdb"
          },
          "rawQuery": true,
          "query": "SELECT max(\"value\") FROM \"vus\" WHERE $timeFilter GROUP BY time($__interval) fill(none)",
          "resultFormat": "time_series",
          "alias": "virtual users"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "k6-influxdb"
          },
          "rawQuery": true,
          "query": "SELECT sum(\"value\") / ($__interval_ms / 1000) FROM \"http_reqs\" WHERE $timeFilter GROUP BY time($__interval) fill(none)",
          "resultFormat": "time_series",
          "alias": "requests / s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9
    },
    {
      "type": "table",
      "title": "p95 per endpoint (selected time range)",
      "datasource": {
        "type": "influxdb",
        "uid": "k6-influxdb"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "k6-influxdb"
          },
          "rawQuery": true,
          "query": "SELECT percentile(\"value\", 95) AS \"p95 ms\", count(\"value\") AS \"requests\" FROM \"http_req_duration\" WHERE $timeFilter AND \"name\" =~ /^(create_simulation|list_overviews|get_simulation_result|get_simulation_stats)$/ GROUP BY \"name\"",
          "resultFormat": "table",
          "alias": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "id": 10
    }
  ],
  "description": "Results of perf/load-test-simulations.js (k6 -> InfluxDB). Thresholds mirror perf/performance-thresholds.json."
