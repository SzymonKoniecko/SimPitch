{
  "uid": "simpitch-k6",
  "title": "SimPitch – k6 simulation engine load test",
  "tags": [
    "simpitch",
    "k6",
    "performance"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Simulations completed",
      "description": "Simulations that reached Completed within MAX_WAIT_S.",
      "datasource": {
        "type": "influxdb",
        "uid": "k6-influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "k6-influxdb"
          },
          "rawQuery": true,
          "query": "SELECT sum(\"value\") FROM \"simulations_completed\" WHERE $timeFilter",
          "resultFormat": "time_series",
          "alias": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Simulation success rate",
      "description": "Threshold: > 95 %",
      "datasource": {
        "type": "influxdb",
        "uid": "k6-influxdb"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "k6-influxdb"
          },
          "rawQuery": true,
          "query": "SELECT mean(\"value\") FROM \"simulation_success\" WHERE $timeFilter",
          "resultFormat": "time_series",
          "alias": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "HTTP error rate",
      "description": "Threshold: < 1 %. 404 while a simulation is being prepared is not an error.",
      "datasource": {
        "type": "influxdb",
        "uid": "k6-influxdb"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "k6-influxdb"
          },
          "rawQuery": true,
          "query": "SELECT mean(\"value\") FROM \"http_req_failed\" WHERE $timeFilter",
          "resultFormat": "time_series",
          "alias": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
