        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "API latency p95 by endpoint",
      "description": "Thresholds (p95): create/list < 500 ms, stats < 1000 ms, result page < 1500 ms. Red line = 500 ms.",
      "datasource": {
        "type": "influxdb",
        "uid": "k6-influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "k6-influxdb"
          },
          "rawQuery": true,
          "query": "SELECT percentile(\"value\", 95) FROM \"http_req_duration\" WHERE $timeFilter AND \"name\" =~ /^(create_simulation|list_overviews|get_simulation_result|get_simulation_stats)$/ GROUP BY time($__interval), \"name\" fill(none)",
          "resultFormat": "time_series",
          "alias": "$tag_name"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "always",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line+area"
            },
            "pointSize": 8
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Simulation duration by model",
      "description": "From creating the simulation until Completed. Threshold p95 < 90 s (ITERATIONS=50).",
      "datasource": {
        "type": "influxdb",
        "uid": "k6-influxdb"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "k6-influxdb"
          },
          "rawQuery": true,
          "query": "SELECT mean(\"value\") FROM \"simulation_duration\" WHERE $timeFilter GROUP BY time($__interval), \"model\" fill(none)",
          "resultFormat": "time_series",
          "alias": "$tag_model"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
